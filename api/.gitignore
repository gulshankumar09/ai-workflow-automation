# ==========================================
# 1. Go Binaries & Compilations
# ==========================================
# Compiled applications (Unix and Windows extensions)
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries generated by 'go test -c'
*.test

# Output of the go coverage tool, e.g., 'go test -coverprofile=coverage.out'
*.out
*.prof

# Common local build directories/binary targets
bin/
dist/
build/
out/

# ==========================================
# 2. Dependencies & Tooling
# ==========================================
# Godep old tool storage
Godeps/

# If you use 'go mod vendor', uncomment the next line to ignore the vendor directory.
# (Most modern Go setups prefer keeping dependencies cached globally, not in the project)
# vendor/

# Gake/Makefile tool build caches if used
.golangci-lint.cache/

# ==========================================
# 3. Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development
.env.production
*.pem
*.key
*.crt

# ==========================================
# 4. Local IDEs & OS Junk
# ==========================================
.idea/
.vscode/
*.sublime-*
*.code-workspace
.DS_Store
Thumbs.db

# ==========================================
# 5. Logs & Temporary Data
# ==========================================
logs/
*.log
*.tmp
*.temp
*.swp
*.swo