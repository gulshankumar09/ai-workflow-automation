# ============================================
# ai-workflow-automation Dynamic Workflow Generation System
# Environment Configuration Template
# ============================================

# Application Configuration
APP_NAME="ai-workflow-automation Core"
APP_VERSION="1.0.0"
APP_DESCRIPTION="ai-workflow-automation Dynamic Workflow Generation System"
ENVIRONMENT="development"

# ============================================
# Database Configuration
# ============================================
DATABASE_PROVIDER=supabase

# Database Provider Settings
DATABASE_PROVIDER_NAME=default
DATABASE_AUTO_CREATE_PROVIDER=true
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECTION_TIMEOUT=30
DATABASE_QUERY_TIMEOUT=30

# Supabase Configuration
SUPABASE_URL=
SUPABASE_API_KEY=
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=


# ============================================
# Cache Configuration
# ============================================
CACHE_PROVIDER="supabase"
CACHE_URL="redis://localhost:6379/0"
CACHE_DEFAULT_TTL=300
CACHE_MAX_CONNECTIONS=10
CACHE_TIMEOUT=5
CACHE_KEY_PREFIX="ai-workflow-automation:"


# ============================================
# LLM Configuration
# ============================================
LLM_PROVIDER="gemini"
LLM_API_KEY="your-llm-api-key"
LLM_MODEL="gemini-pro"
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_RETRY_ATTEMPTS=3


# ============================================
# MCP (Model Context Protocol) Configuration
# ============================================
MCP_SERVERS_CONFIG_PATH="./configs/mcp_servers.yaml"
MCP_CONNECTION_TIMEOUT=30
MCP_REQUEST_TIMEOUT=60
MCP_RETRY_ATTEMPTS=3
MCP_HEALTH_CHECK_INTERVAL=60
MCP_MAX_CONCURRENT_CONNECTIONS=10

# Tool-specific MCP configurations
MCP_SLACK_APP_TOKEN="xapp-your-slack-app-token"
MCP_SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"
MCP_NOTION_API_KEY="secret_your-notion-integration-key"
MCP_GITHUB_TOKEN="ghp_your-github-personal-access-token"
MCP_GOOGLE_API_KEY="your-google-api-key"

# ============================================
# Security Configuration
# ============================================
SECURITY_JWT_SECRET_KEY="your-super-secret-jwt-key-min-32-chars"
SECURITY_JWT_ALGORITHM="HS256"
SECURITY_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
SECURITY_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption settings
SECURITY_ENCRYPTION_KEY="your-32-byte-encryption-key-here"
SECURITY_PASSWORD_HASH_ALGORITHM="bcrypt"
SECURITY_PASSWORD_MIN_LENGTH=8

# Rate limiting
SECURITY_RATE_LIMIT_REQUESTS=100
SECURITY_RATE_LIMIT_WINDOW=60

# ============================================
# Monitoring & Observability
# ============================================
MONITORING_PROMETHEUS_ENABLED=true
MONITORING_PROMETHEUS_PORT=8001

# Logging
MONITORING_LOG_LEVEL="INFO"
MONITORING_LOG_FORMAT="json"
MONITORING_LOG_FILE_PATH=""

# Tracing
MONITORING_JAEGER_ENABLED=false
MONITORING_JAEGER_ENDPOINT="http://localhost:14268/api/traces"

# Health checks
MONITORING_HEALTH_CHECK_ENABLED=true
MONITORING_HEALTH_CHECK_INTERVAL=30

# ============================================
# Server Configuration
# ============================================
SERVER_HOST="0.0.0.0"
SERVER_PORT=8000
SERVER_WORKERS=10
SERVER_RELOAD=true
SERVER_DEBUG=false

# gRPC settings
SERVER_GRPC_PORT=50051

# Health check server port
SERVER_HEALTH_PORT=8080

# WebSocket settings
SERVER_WEBSOCKET_PING_INTERVAL=20
SERVER_WEBSOCKET_PING_TIMEOUT=20 